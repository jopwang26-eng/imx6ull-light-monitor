# Public repository allowlist. Everything else stays local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/GLOSSARY.md
!/Makefile
!/apps/
!/drivers/
!/device-tree/
!/tools/
!/docs/

# Only the selected documentation is public.
/docs/*
!/docs/BUILD.md
!/docs/HARDWARE.md
!/docs/VALIDATION.md
!/docs/PUBLISHING.md
!/docs/validation/
/docs/validation/*.txt

# Credentials and agent/editor configuration, at any depth.
**/.codex/
**/.agents/
**/.aws/
**/.ssh/
**/.vscode/
**/.idea/
**/.env
**/.env.*
**/auth.json
**/credentials
**/credentials.*
**/secrets.json
**/secrets.*
**/id_rsa*
**/id_ed25519*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.local

# Build products, runtime data, caches and local archives.
*.o
*.ko
*.mod.c
*.mod
*.cmd
*.so
*.a
*.elf
*.bin
*.dtb
*.dtbo
Module.symvers
modules.order
.tmp_versions/
__pycache__/
*.py[cod]
*.log
*.csv
*.tar
*.tar.gz
*.zip
*.7z
*.bak
*.before_*
node_modules/
build/
dist/
logs*/
backup*/
/apps/light_monitor/light_monitor
**/light_monitor_native
**/beep_test
**/beep_api_test
**/lightap_test
**/key_event_test
**/nfs_observer
**/nfs_observer_native
**/check_nack
**/base.c
